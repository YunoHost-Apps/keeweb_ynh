#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# INSTALL SOURCES
#=================================================
ynh_script_progression "Setting up source files..."

# To avoid a complete rebuild, I downloaded the gh-pages as explained here: https://github.com/keeweb/keeweb#self-hosting
# and put all files in "../sources/", like that I can assure the version install in YunoHost is the version described in the manifest
mkdir -p "$install_dir"
cp -r ../sources/extra_files/app/* "$install_dir"

#=================================================
# NGINX CONFIGURATION
#=================================================
ynh_script_progression "Configuring NGINX web server..."

ynh_config_add_nginx

#=================================================
# SPECIFIC SETUP
#=================================================
# USE THE CONFIG FILE
#=================================================

ynh_replace --match="(no-config)" --replace="config.json" --file="$install_dir/index.html"

#=================================================
# COPY THE CONFIG FILE
#=================================================
ynh_script_progression "Adding $app's configuration..."

ynh_config_add --template="config.json" --destination="$install_dir/config.json"

#=================================================
# SECURING FILES AND DIRECTORIES
#=================================================

# Les fichiers appartiennent à root
chmod 750 "$install_dir"
chmod -R o-rwx "$install_dir"
chown -R $app:www-data "$install_dir"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
